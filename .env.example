# Public values obtained from Supabase Dashboard > Connect. They are safe to expose
# to the browser only because Row Level Security protects every data table.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"

# Public URL where the SPA is deployed; configure it as a Supabase Auth redirect URL.
VITE_APP_URL="http://localhost:5173"
